# JobShield AI — env template

# Path to the generated artifacts JSON. The API and the Python CLI both
# read/write this file. Keep it inside the repo for the demo; for a
# deployment, point it at a shared volume.
JOBSHIELD_ARTIFACTS=data/artifacts.json
JOBSHIELD_WEB_ROOT=ts/web

# Port the Bun.serve API listens on. 3000 is the default in the spec.
PORT=3000

# In-memory token-bucket rate limiter for /api/*. Env-overridable so
# load tests and CI can tune the window without touching code.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Python side — no secrets. The mock dataset is deterministic by design.
# To regenerate it: `cd py && uv run python -m jobshield.data.mock_data`
# To rebuild artifacts: `cd py && uv run python -m jobshield.cli.build --mock`
