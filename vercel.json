{
  "buildCommand": "bun run build:web",
  "outputDirectory": "ts/web/dist",
  "installCommand": "bun install",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "runtime": "bun1.x",
      "includeFiles": "data/artifacts.json, ts/web/dist/**, ts/web/index.html, ts/web/src/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/web/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
